CCS_DATA_DIR=./data
CCS_LICENSE_MODE=demo
CCS_LICENSE_EXPIRES=

# Im Demomodus optional. Im Lizenzmodus vor dem ersten Start zwingend setzen.
# Jedes Kennwort muss mindestens 12 Zeichen enthalten.
CCS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CCS_SUPPORT_PASSWORD=replace-with-a-strong-support-password
CCS_VIEWER_PASSWORD=replace-with-a-strong-viewer-password

# V0.3 PostgreSQL Runtime
CCS_DATABASE_URL=postgresql://ccs:replace-me@127.0.0.1:5432/ccs_support
CCS_TENANT_ID=compelec
CCS_TENANT_NAME=Compelec Computersysteme GmbH

# Embedding: local-hash bleibt nur für Entwicklung/Test vorgesehen.
# Für produktive Semantik auf openai-compatible umstellen und Werte freigeben.
CCS_EMBEDDING_PROVIDER=local-hash
CCS_EMBEDDING_ENDPOINT=https://example.invalid/v1/embeddings
CCS_EMBEDDING_API_KEY=replace-with-secret
CCS_EMBEDDING_MODEL=replace-with-approved-model
CCS_EMBEDDING_DIMENSIONS=1536
CCS_EMBEDDING_TIMEOUT_SECONDS=20
CCS_EMBEDDING_MAX_RETRIES=2

# OIDC / Microsoft Entra ID (nur aktivieren, wenn CCS_IDENTITY_MODE=oidc)
# OIDC Access Tokens werden gegen Issuer, Audience, Signatur und Ablaufzeit geprüft.
CCS_IDENTITY_MODE=trusted-header
# Nur setzen, wenn ein vorgeschalteter Proxy alle eingehenden x-compelec-*-Header entfernt und selbst neu setzt.
# In Produktion muss der Proxy x-compelec-user, x-compelec-role UND x-compelec-tenant setzen.
# In Produktion bei bewusstem Trusted-Header-Betrieb zwingend:
# CCS_TRUSTED_HEADER_MODE_ACK=I_TRUST_MY_AUTHENTICATING_PROXY
CCS_OIDC_ISSUER=https://login.microsoftonline.com/<TENANT-ID>/v2.0
CCS_OIDC_AUDIENCE=api://<APPLICATION-CLIENT-ID>
CCS_OIDC_JWKS_URL=https://login.microsoftonline.com/<TENANT-ID>/discovery/v2.0/keys
CCS_OIDC_ROLE_CLAIM=roles
CCS_OIDC_TENANT_CLAIM=tid
CCS_OIDC_USERNAME_CLAIM=preferred_username
# Mapping externer App-Rollen/Gruppen auf COMPELEC-Rollen; in Produktion zwingend explizit setzen.
CCS_OIDC_ROLE_MAP={"Compelec.Admin":"admin","Compelec.Support":"agent","Compelec.ReadOnly":"viewer"}
# Externe IdP-Tenant-ID explizit auf internen COMPELEC-Mandanten abbilden.
CCS_OIDC_TENANT_MAP={"<IDP-TENANT-GUID>":"compelec"}
