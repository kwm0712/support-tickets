CCS_DATA_DIR=./data
CCS_LICENSE_MODE=demo
CCS_LICENSE_EXPIRES=

# Im Demomodus optional. Im Lizenzmodus vor dem ersten Start zwingend setzen.
# Jedes Kennwort muss mindestens 12 Zeichen enthalten.
CCS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CCS_SUPPORT_PASSWORD=replace-with-a-strong-support-password
CCS_VIEWER_PASSWORD=replace-with-a-strong-viewer-password

# V0.3 PostgreSQL Runtime
CCS_DATABASE_URL=postgresql://ccs:replace-me@127.0.0.1:5432/ccs_support
CCS_TENANT_ID=compelec
CCS_TENANT_NAME=Compelec Computersysteme GmbH

# Embedding: local-hash bleibt nur für Entwicklung/Test vorgesehen.
# Für produktive Semantik auf openai-compatible umstellen und Werte freigeben.
CCS_EMBEDDING_PROVIDER=local-hash
CCS_EMBEDDING_ENDPOINT=https://example.invalid/v1/embeddings
CCS_EMBEDDING_API_KEY=replace-with-secret
CCS_EMBEDDING_MODEL=replace-with-approved-model
CCS_EMBEDDING_DIMENSIONS=1536
CCS_EMBEDDING_TIMEOUT_SECONDS=20
CCS_EMBEDDING_MAX_RETRIES=2
